# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/release/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Super-admin recovery codes - never commit
recovery-codes.txt

# Legacy pre-Postgres SQLite databases. These were tracked until now, and the committed
# copies held real workspace financial data and the user table including password hashes.
# The live data lives in Postgres (DATABASE_URL); nothing here should ever be committed.
*.sqlite
*.sqlite-shm
*.sqlite-wal
/database/
